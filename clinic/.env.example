# --- Server ---
# The public address of the app, with no trailing slash. The only place the domain is configured:
# moving to another domain = change this + DNS. Several origins may be listed, comma-separated
# (the first is canonical), e.g. during a domain move.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Reverse proxies in front of the app: 0 locally, 1 on Liara.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/clinic_dev
# Used only by `npm test`. The database name MUST end in _test: the test run wipes it.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/clinic_test

# --- Backups ---
# Daily pg_dump backups go here (on Liara: /app/backups, the mounted disk). Unset = no backups.
# BACKUP_DIR=./backups
# BACKUP_KEEP=30
# Hour of the clinic's day (Tehran time) for the daily backup.
# BACKUP_HOUR=3

# --- Seed (first run only; `npm run db:seed`) ---
SEED_DOCTOR_NAME=دکتر
SEED_DOCTOR_PASSWORD=
SEED_SECRETARY_NAME=منشی
SEED_SECRETARY_PASSWORD=
