{
  "name": "clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "dev:web": "next dev -p 3001",
    "build:web": "next build",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@node-rs/argon2": "2.2.2",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
