{
  "name": "clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev --local-upstream localhost:8787",
    "dev:web": "next dev -p 3001",
    "build:web": "next build && node scripts/finalize-sw.mjs",
    "types": "wrangler types src/worker/worker-configuration.d.ts --include-env=false",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "npm run build:web && playwright test",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wrangler": "4.151.1",
    "ws": "8.18.3"
  }
}
