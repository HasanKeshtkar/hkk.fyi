{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src/server",
    "src/shared",
    "scripts",
    "tests/db",
    "tests/api",
    "tests/shared",
    "tests/helpers",
    "tests/global-setup.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ]
}
