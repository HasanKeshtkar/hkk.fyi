// Cloudflare deployment of the clinic app (free plan). CI deploys it on every push that passes all
// checks (see .github/workflows/clinic.yml). Domain and names are settings, not code: moving to
// another domain = change APP_ORIGIN and the route below (and nothing else).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinic",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "clinic.hkk.fyi", "custom_domain": true }],
  // The built web app (npm run build:web). Every request passes through the Worker first so all
  // responses get the security headers.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [{ "name": "CLINIC", "class_name": "Clinic" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Clinic"] }],
  // Daily backup at 03:00 Tehran time (23:30 UTC).
  "triggers": { "crons": ["30 23 * * *"] },
  "vars": {
    "APP_ORIGIN": "https://clinic.hkk.fyi",
    "SEED_DOCTOR_NAME": "دکتر جهانمردی",
    "SEED_SECRETARY_NAME": "منشی"
  },
  "observability": { "enabled": true }
}
